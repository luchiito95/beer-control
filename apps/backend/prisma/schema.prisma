// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum StockStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  CORRECTION
}

enum InventoryMovementReason {
  PURCHASE
  SALE
  TRANSFER
  RETURN
  DAMAGE
  EXPIRED
  INVENTORY_COUNT
  MANUAL
  PRODUCTION
  CONSUMPTION
}

enum InventoryMovementSource {

  PURCHASE_ORDER
  PURCHASE_RECEIPT
  SALES_ORDER
  SALES_INVOICE
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  STOCK_COUNT
  PRODUCTION_ORDER
  MANUAL
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
}

model Company {
  id           String        @id @default(cuid())
  name         String
  legalName    String?
  taxId        String?
  email        String?
  phone        String?
  currencyCode String        @default("COP")
  timezone     String        @default("America/Bogota")
  status       CompanyStatus @default(TRIAL)

  // Relaciones
  branches Branch[]
  categories Category[]
  brands Brand[]
  units Unit[]
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

model Branch {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code String
  name String

  email   String?
  phone   String?
  address String?

  city  String
  state String?

  country String

  postalCode String?

  timezone String

  status BranchStatus @default(ACTIVE)

  // Relación
  warehouses Warehouse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model Warehouse {
  id          String            @id @default(cuid())

  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])

  code        String
  name        String
  description String?

  status      WarehouseStatus   @default(ACTIVE)

  stocks Stock[]
  movements InventoryMovement[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@unique([branchId, code])

  @@map("warehouses")
}

model Category {

  id String @id @default(cuid())

  companyId String
  company Company @relation(fields: [companyId], references: [id])

  parentId String?
  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  code String

  name String

  description String?

  status CategoryStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])

  @@index([companyId])
  @@index([parentId])
  @@index([status])

}

model Brand {
  id          String      @id @default(cuid())

  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])

  code        String
  name        String
  description String?

  status      BrandStatus @default(ACTIVE)

  products Product[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model Unit {
  id          String     @id @default(cuid())

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])

  code        String
  name        String
  symbol      String
  description String?

  status      UnitStatus @default(ACTIVE)

  products Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model Product {

  id String @id @default(cuid())

  companyId String
  company Company @relation(fields:[companyId], references:[id])

  categoryId String
  category Category @relation(fields:[categoryId], references:[id])

  brandId String
  brand Brand @relation(fields:[brandId], references:[id])

  unitId String
  unit Unit @relation(fields:[unitId], references:[id])

  code String

  sku String?

  barcode String?

  name String

  description String?

  purchasePrice Decimal

  cost Decimal

  salePrice Decimal

  imageUrl String?

  status ProductStatus @default(ACTIVE)

  stocks Stock[]
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])

  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([status])

}

model Stock {

  id String @id @default(cuid())

  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  productId String
  product Product @relation(fields: [productId], references: [id])

  /// Existencia física
  onHand Decimal @default(0) @db.Decimal(18,4)

  /// Cantidad reservada
  reserved Decimal @default(0) @db.Decimal(18,4)

  /// Costo promedio ponderado
  averageCost Decimal @default(0) @db.Decimal(18,4)

  status StockStatus @default(ACTIVE)

  movements InventoryMovement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([warehouseId, productId])

  @@index([warehouseId])

  @@index([productId])

  @@index([status])

  @@map("stocks")

}

model InventoryMovement {

  id String @id @default(cuid())

  stockId String
  stock Stock @relation(fields:[stockId], references:[id])

  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId], references:[id])

  productId String
  product Product @relation(fields:[productId], references:[id])

  type InventoryMovementType

  reason InventoryMovementReason

  source InventoryMovementSource

  referenceId String?

  quantity Decimal @db.Decimal(18,4)

  balanceBefore Decimal @db.Decimal(18,4)

  balanceAfter Decimal @db.Decimal(18,4)

  unitCost Decimal @db.Decimal(18,4)

  performedBy String

  performedAt DateTime

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([stockId])

  @@index([warehouseId])

  @@index([productId])

  @@index([performedAt])

}